# Copy to .env and replace with a fresh secret. Never commit .env.
PASTE_ADMIN_TOKEN=replace_with_output_of_openssl_rand_hex_32

# Optional rate limit: maximum paste creations per minute per client IP (default 0 = disabled)
PASTE_RATE_LIMIT_PER_MINUTE=0
# Set to 1 if lan-paste is deployed behind a trusted reverse proxy and should parse X-Forwarded-For
PASTE_BEHIND_PROXY=0
